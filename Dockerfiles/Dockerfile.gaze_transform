FROM registry.git.ee.ethz.ch/pbl/research/robodog/ros_base_layers/ros_humble

WORKDIR $ROS_WS
COPY gaze_transform $ROS_WS/src/gaze_transform/

RUN cd $ROS_WS/src/ && \
    git clone git@git.ee.ethz.ch:pbl/research/smart-glasses/gaze_tracking/ros2_msgs.git

RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build

USER $USER_NAME