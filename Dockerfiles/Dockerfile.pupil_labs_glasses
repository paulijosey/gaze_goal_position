FROM registry.git.ee.ethz.ch/pbl/research/robodog/ros_base_layers/ros_humble

# install the blink detection package from pupil labs
USER root
# RUN mkdir -p /python_packages \
#     && cd /python_packages \
#     && git clone https://github.com/paulijosey/real-time-blink-detection.git \
#     && cd real-time-blink-detection \
#     && pip install -e .

RUN mkdir -p /python_packages \
    && cd /python_packages \
    && git clone https://github.com/paulijosey/realtime-python-api.git \
    && cd realtime-python-api \
    && git checkout fix/imuData \
    && pip install -e .

WORKDIR $ROS_WS
COPY pupil_labs_glasses $ROS_WS/src/pupil_labs_glasses/
RUN cd $ROS_WS/src/ && \
    git clone git@git.ee.ethz.ch:pbl/research/smart-glasses/gaze_tracking/ros2_msgs.git
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build

USER $USER_NAME